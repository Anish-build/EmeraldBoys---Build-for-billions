# ============================================================
# Emerald Boys — Environment Configuration Template
# Copy this file to .env and customize values for local development.
# ============================================================

# LLM Configuration (OpenAI or OpenRouter compatible)
# Leave empty or set to 'mock' to run the transparent deterministic prototype agent locally.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Agent Execution Mode: 'auto' (uses OpenAI if API key provided, else deterministic prototype),
# 'openai' (enforces live OpenAI calls), or 'mock' (deterministic prototype reasoning)
AGENT_MODE=auto

# ML Anomaly Thresholds (0.0 to 1.0)
ML_HIGH_CONFIDENCE_THRESHOLD=0.70
ML_LOW_CONFIDENCE_THRESHOLD=0.40

# Backend & Security Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit Frontend Configuration
BACKEND_URL=http://127.0.0.1:8000

# Optional Escalation Webhook (leave empty if not using an external alerting webhook)
ESCALATION_WEBHOOK_URL=